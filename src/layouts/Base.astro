---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { langs, switchLang, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** JSON-LD (schema.org) específico de la página */
  jsonLd?: Record<string, unknown>;
  /** false para páginas que no deben indexarse en Pagefind (listados, legal) */
  searchable?: boolean;
  /** Superficie del contenido: oscura (por defecto) o clara (fichas) */
  surface?: 'dark' | 'light';
  /** Home: cabecera transparente sobre el hero hasta que se hace scroll */
  home?: boolean;
}

const { lang, title, description, jsonLd, searchable = true, surface = 'dark', home = false } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} · ${t('site.fullName')}`;
const desc = description ?? t('site.tagline');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0a0d0f" />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLang(Astro.url.pathname, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLang(Astro.url.pathname, 'en'), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Tema guardado (toggle del hero) antes de pintar, para evitar parpadeo -->
    <script is:inline>
      try { const th = localStorage.getItem('nesg-theme'); if (th === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class:list={['surface-dark', home && 'is-home']}>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} overlay={home} />
    <main id="main" class={`surface-${surface}`} data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="viz-tip" role="tooltip" aria-hidden="true"></div>
  </body>
</html>

<script>
  // Tooltip compartido: cualquier elemento con data-tip="<html>" lo muestra al pasar / enfocar.
  const tip = document.querySelector<HTMLElement>('.viz-tip')!;
  const show = (el: HTMLElement, x: number, y: number) => {
    tip.innerHTML = el.dataset.tip!;
    tip.classList.add('is-on');
    const r = tip.getBoundingClientRect();
    tip.style.left = `${Math.min(window.innerWidth - r.width - 8, Math.max(8, x + 14))}px`;
    tip.style.top = `${Math.max(8, y - r.height - 14)}px`;
  };
  const hide = () => tip.classList.remove('is-on');
  document.addEventListener('pointermove', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
    el ? show(el, e.clientX, e.clientY) : hide();
  });
  document.addEventListener('focusin', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
    if (!el) return hide();
    const r = el.getBoundingClientRect();
    show(el, r.left + r.width / 2, r.top);
  });
  document.addEventListener('focusout', hide);
  window.addEventListener('scroll', hide, { passive: true });

  // Entrada progresiva de bloques .reveal y gráficas
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal, .viz').forEach((el) => io.observe(el));

  // Cifras que se cuentan al aparecer: <span data-countup="148">148</span> (sufijo opcional: data-countup-suffix="%")
  // (el HTML trae el valor final: sin JS o con "reducir movimiento" se ve tal cual)
  const counters = document.querySelectorAll<HTMLElement>('[data-countup]');
  if (counters.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const nf = new Intl.NumberFormat(document.documentElement.lang === 'es' ? 'es-ES' : 'en-GB');
    const run = (el: HTMLElement, i: number) => {
      const end = Number(el.dataset.countup);
      const dur = 1400 + Math.min(end, 3000) / 5; // números grandes, algo más lentos
      const t0 = performance.now() + i * 120;
      const tick = (now: number) => {
        const p = Math.min(1, Math.max(0, (now - t0) / dur));
        el.textContent = nf.format(Math.round(end * (1 - (1 - p) ** 3))) + (el.dataset.countupSuffix ?? '');
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const cio = new IntersectionObserver((entries) => {
      entries.filter((e) => e.isIntersecting).forEach((e, i) => { run(e.target as HTMLElement, i); cio.unobserve(e.target); });
    }, { threshold: 0.5 });
    counters.forEach((el) => { el.textContent = nf.format(0) + (el.dataset.countupSuffix ?? ''); cio.observe(el); });
  }
</script>
