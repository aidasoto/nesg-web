---
/** Resources: datasets, código y herramientas abiertas (anexo de Publicaciones). */
import { getCollection, getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { l, langPaths, localize, md, useTranslations } from '@/i18n/utils';
import type { Lang, UIKey } from '@/i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const resources = await getCollection('resources');
const withPubs = await Promise.all(resources.map(async (r) => ({ r, pubs: await getEntries(r.data.publications) })));
---

<Base lang={lang} title={t('nav.resources')}>
  <div class="container section">
    <p class="section-head__idx">// RESOURCES</p>
    <h1>{t('nav.resources')}</h1>
    <p class="muted">{t('resources.intro')}</p>
    <ul class="grid list-plain">
      {withPubs.map(({ r, pubs }) => (
        <li class="card">
          <span class="kicker">{t(`resourcekind.${r.data.kind}` as UIKey)}{r.data.license && ` · ${r.data.license}`}</span>
          <h3><a href={r.data.url} rel="noopener">{r.data.title} ↗</a></h3>
          <div class="small" set:html={md(localize(r.data.description, lang))} />
          {pubs.map((p) => <p class="small">→ <a href={l(lang, `/publications/${p.id}/`)}>{p.data.title}</a></p>)}
        </li>
      ))}
    </ul>
    <a class="back" href={l(lang, '/publications/')}>← {t('nav.publications')}</a>
  </div>
</Base>
