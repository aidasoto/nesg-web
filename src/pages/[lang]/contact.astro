---
/**
 * Contacto (SEO local). Sin backend → sin formulario: GitHub + dirección + mapa.
 * El mapa es un iframe de OpenStreetMap (sin cookies de seguimiento); hay que
 * permitir frame-src https://www.openstreetmap.org en la CSP del servidor.
 */
import Base from '@/layouts/Base.astro';
import { langPaths, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { site } from '@/config/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { lat, lon } = site.geo;
const d = 0.004;
const bbox = [lon - d, lat - d / 2, lon + d, lat + d / 2].join(',');
const { street, postalCode, city } = site.address;
---

<Base lang={lang} title={t('nav.contact')}>
  <div class="container section contact">
    <div>
      <p class="section-head__idx">// CONTACT</p>
    <h1>{t('nav.contact')}</h1>
      <h2>GitHub</h2>
      <p><a class="btn btn--primary" href={site.github} rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg> github.com/NESG-group ↗</a></p>
      <h2>{t('contact.address')}</h2>
      <address>NESG – Network Engineering & Security Group<br />{street}<br />{postalCode} {city}, España</address>
    </div>
    <div>
      <h2 class="visually-hidden">{t('contact.map')}</h2>
      <iframe
        title={t('contact.map')}
        src={`https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`}
        loading="lazy" referrerpolicy="no-referrer"></iframe>
      <p class="small"><a href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`}>OpenStreetMap ↗</a></p>
    </div>
  </div>
</Base>

<style>
  .contact { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  address { font-style: normal; }
  iframe { width: 100%; aspect-ratio: 4 / 3; border: 1px solid var(--border); border-radius: var(--radius); }
</style>
