---
/** Páginas de texto simples (aviso legal, privacidad) desde src/content/pages. */
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { langs } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export function getStaticPaths() {
  return langs.flatMap((lang) => ['legal', 'privacy'].map((page) => ({ params: { lang, page } })));
}
const lang = Astro.params.lang as Lang;
const entry = (await getEntry('pages', `${lang}/${Astro.params.page}`)) ?? (await getEntry('pages', `en/${Astro.params.page}`))!;
const { Content } = await render(entry);
---

<Base lang={lang} title={entry.data.title} searchable={false}>
  <article class="container section prose">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</Base>
