---
/** Búsqueda global con Pagefind (índice estático generado tras el build). */
import Base from '@/layouts/Base.astro';
import { langPaths, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('nav.search')} searchable={false}>
  <div class="container section">
    <p class="section-head__idx">// SEARCH</p>
    <h1>{t('nav.search')}</h1>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <noscript>JavaScript is required for search.</noscript>
  </div>
</Base>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  // Pagefind separa índices por <html lang>, así que solo busca en el idioma actual.
  window.addEventListener('DOMContentLoaded', () => {
    // eslint-disable-next-line no-undef
    new PagefindUI({ element: '#search', showSubResults: true, autofocus: true });
  });
</script>
