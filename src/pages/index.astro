---
/** Raíz "/": envía al idioma del navegador (es → /es/, resto → /en/). */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>NESG</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/en/" />
    <script is:inline>
      location.replace((navigator.language || '').toLowerCase().startsWith('es') ? '/es/' : '/en/');
    </script>
    <meta http-equiv="refresh" content="1; url=/en/" />
  </head>
  <body><a href="/en/">English</a> · <a href="/es/">Español</a></body>
</html>
