---
import { Image } from 'astro:assets';
import { getEntries } from 'astro:content';
import { l, localize } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import type { Person } from '@/lib/data';

interface Props {
  person: Person;
  lang: Lang;
  compact?: boolean;
  /** Tarjeta grande (p. ej. dirección del grupo) */
  featured?: boolean;
  note?: string;
  counts?: { pubs: number; projects: number };
}
const { person, lang, compact = false, featured = false, note, counts } = Astro.props;
const d = person.data;
const lines = await getEntries(d.lines);
const initials = d.name.split(' ').filter((w) => w.length > 2).map((w) => w[0]).slice(0, 2).join('');
const es = lang === 'es';
---

<a class:list={['card', 'person', compact && 'person--compact', featured && 'person--featured', featured && 'card--frame']} href={l(lang, `/team/${person.id}/`)}>
  {d.photo
    ? <Image src={d.photo} alt="" width={featured ? 320 : 160} height={featured ? 320 : 160} class="person__photo" />
    : <span class="person__photo person__photo--ph" aria-hidden="true">{initials}</span>}
  <div class="person__body">
    {note && <span class="kicker kicker--accent">{note}</span>}
    <h3>{d.name}</h3>
    {d.position && <p class="person__pos">{localize(d.position, lang)}</p>}
    {!compact && lines.length > 0 && <ul class="person__lines list-plain">{lines.map((ln) => <li>{localize(ln.data.title, lang)}</li>)}</ul>}
    {counts && (counts.pubs > 0 || counts.projects > 0) && (
      <dl class="person__counts">
        <div><dt>{es ? 'Publ.' : 'Pubs'}</dt><dd>{counts.pubs}</dd></div>
        <div><dt>{es ? 'Proy.' : 'Projects'}</dt><dd>{counts.projects}</dd></div>
      </dl>
    )}
  </div>
  <svg class="person__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>

<style>
  .person { display: flex; gap: 1.1rem; align-items: flex-start; height: 100%; }
  .person__body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .person h3 { margin: .1rem 0 .2rem; font-size: 1.1rem; }
  .person__pos { margin: 0 0 .7rem; font: .78rem var(--font-mono); color: var(--muted); }
  .person__photo { width: 76px; height: 76px; border-radius: 12px; object-fit: cover; flex: none; filter: grayscale(1) contrast(1.05); transition: filter .3s; }
  .person:hover .person__photo { filter: none; }
  .person__photo--ph { display: grid; place-items: center; background: var(--accent-soft); border: 1px solid var(--border); color: var(--accent); font: 600 1.1rem var(--font-mono); letter-spacing: .05em; }
  .person__lines { display: grid; gap: .3rem; margin-bottom: .9rem; font-size: .82rem; line-height: 1.3; color: var(--fg); }
  .person__lines li { display: flex; gap: .5rem; align-items: baseline; }
  .person__lines li::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 2px; background: var(--accent); transform: translateY(-1px); }
  .person__counts { display: flex; gap: 1.5rem; margin: auto 0 0; padding-top: .75rem; border-top: 1px dashed var(--border); }
  .person__counts dt { font: 500 .6rem var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .person__counts dd { margin: .1rem 0 0; font: 600 1.1rem var(--font-display); color: var(--fg-strong); font-variant-numeric: tabular-nums; }
  .person__arrow { flex: none; color: var(--muted); transition: transform .25s var(--ease), color .25s; }
  .person:hover .person__arrow { color: var(--accent); transform: translate(3px, -3px); }

  .person--compact .person__photo { width: 48px; height: 48px; font-size: .85rem; border-radius: 10px; }

  .person--featured { padding: 1.75rem; gap: 1.75rem; background: linear-gradient(135deg, var(--accent-soft), var(--card) 60%); }
  .person--featured .person__photo { width: 150px; height: 150px; border-radius: 16px; font-size: 2.4rem; }
  .person--featured h3 { font-size: clamp(1.4rem, 2.2vw, 2rem); }
  .person--featured .person__counts dd { font-size: 1.6rem; }
  @media (max-width: 600px) {
    .person--featured { flex-direction: column; }
    .person--featured .person__photo { width: 96px; height: 96px; font-size: 1.6rem; }
  }
</style>
