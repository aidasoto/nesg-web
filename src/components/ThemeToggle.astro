---
/** Interruptor claro / oscuro. Guarda la preferencia (localStorage) para toda la web. */
interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const labels = lang === 'es' ? ['Modo claro', 'Modo oscuro'] : ['Light mode', 'Dark mode'];
---

<button class="tt" role="switch" aria-checked="false" data-theme-toggle data-label-light={labels[0]} data-label-dark={labels[1]}>
  <span class="tt__track"><span class="tt__thumb"></span></span>
  <span class="tt__label">{labels[0]}</span>
</button>

<style>
  .tt { display: inline-flex; align-items: center; gap: .7rem; background: none; border: 0; padding: .25rem 0; cursor: pointer; color: inherit; font: 500 .7rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .12em; }
  .tt__track { position: relative; width: 42px; height: 22px; border-radius: 999px; border: 1px solid currentColor; opacity: .9; }
  .tt__thumb { position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); transition: transform .3s var(--ease); }
  .tt[aria-checked='true'] .tt__thumb { transform: translateX(20px); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    const root = document.documentElement;
    const label = btn.querySelector('.tt__label')!;
    const sync = () => {
      const light = root.dataset.theme === 'light';
      btn.setAttribute('aria-checked', String(light));
      label.textContent = (light ? btn.dataset.labelDark : btn.dataset.labelLight) ?? '';
    };
    sync();
    btn.addEventListener('click', () => {
      const light = root.dataset.theme !== 'light';
      if (light) root.dataset.theme = 'light'; else delete root.dataset.theme;
      try { localStorage.setItem('nesg-theme', light ? 'light' : 'dark'); } catch (e) {}
      sync();
      window.dispatchEvent(new CustomEvent('themechange'));
    });
  });
</script>
