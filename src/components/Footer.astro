---
import { l, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { site } from '@/config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const { street, postalCode, city } = site.address;
const { lat, lon } = site.geo;
const cols = [
  [t('nav.about'), '/about/'], [t('nav.lines'), '/research-lines/'], [t('nav.projects'), '/projects/'],
  [t('nav.publications'), '/publications/'], [t('nav.team'), '/team/'], [t('nav.news'), '/news/'],
];
---

<footer class="ftr surface-dark">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <p class="ftr__logo">NESG</p>
      <p class="muted small">{t('site.fullName')}<br />Universidad de Granada</p>
    </div>
    <nav aria-label="Footer">
      <p class="kicker">Index</p>
      <ul class="list-plain ftr__links">{cols.map(([label, href]) => <li><a href={l(lang, href)}>{label}</a></li>)}</ul>
    </nav>
    <div>
      <p class="kicker">{t('nav.contact')}</p>
      <address class="small">{street}<br />{postalCode} {city}</address>
      <p class="small"><a class="ftr__gh" href={site.github} rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg> GitHub · NESG-group</a></p>
      <p class="kicker ftr__geo">{lat.toFixed(4)}° N · {Math.abs(lon).toFixed(4)}° W</p>
    </div>
  </div>
  <div class="container ftr__bottom">
    <span>© {new Date().getFullYear()} NESG · UGR</span>
    <span><a href={l(lang, '/legal/')}>{t('footer.legal')}</a> · <a href={l(lang, '/privacy/')}>{t('footer.privacy')}</a></span>
  </div>
</footer>

<style>
  .ftr { position: relative; z-index: 2; background: #050708; color: #e6ecea; border-top: 1px solid #1c2427; padding: 4rem 0 1.5rem; }
  :global(:root[data-theme='light']) .ftr { background: var(--bg-alt); color: var(--fg); border-color: var(--border); }
  .ftr__grid { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .ftr__logo { font: 700 2.4rem/1 var(--font-display); letter-spacing: .12em; margin: 0 0 .75rem; }
  .ftr__links { display: grid; gap: .4rem; margin-top: .75rem; }
  .ftr__links a, .ftr__bottom a { color: inherit; text-decoration: none; opacity: .8; }
  .ftr__links a:hover, .ftr__bottom a:hover { color: var(--accent); opacity: 1; }
  address { font-style: normal; margin: .75rem 0; }
  .ftr__geo { margin-top: 1rem; }
  .ftr__gh { display: inline-flex; align-items: center; gap: .5rem; color: inherit; text-decoration: none; }
  .ftr__gh:hover { color: var(--accent); }
  .ftr__bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--border); font: .72rem var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
</style>
