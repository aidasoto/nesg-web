---
/**
 * Cronograma (Gantt) de proyectos: una fila por proyecto, color por tipo
 * (investigación / transferencia), línea vertical en "hoy". Filas enlazables.
 */
import type { Lang } from '@/i18n/ui';
import { l, localize, formatDate } from '@/i18n/utils';
import { projectStatus, type Project } from '@/lib/data';
import { esc } from '@/lib/charts';

interface Props { projects: Project[]; lang: Lang; title: string; highlight?: string }
const { projects, lang, title, highlight } = Astro.props;
const items = [...projects].sort((a, b) => +a.data.start - +b.data.start);
const now = new Date();
const startYear = Math.min(...items.map((p) => p.data.start.getFullYear()));
const endYear = Math.max(now.getFullYear(), ...items.map((p) => (p.data.end ?? now).getFullYear())) + 1;
const span = +new Date(endYear, 0, 1) - +new Date(startYear, 0, 1);
const pct = (d: Date) => ((+d - +new Date(startYear, 0, 1)) / span) * 100;
const years = Array.from({ length: endYear - startYear + 1 }, (_, i) => startYear + i);
const yearStep = years.length > 10 ? 2 : 1;
const COLORS = { research: 'var(--s1)', transfer: 'var(--s2)' } as const;
const LABEL = { research: { en: 'Research', es: 'Investigación' }, transfer: { en: 'Transfer', es: 'Transferencia' } };
const types = [...new Set(items.map((p) => p.data.type))];
---

{items.length > 0 && (
<figure class="viz tl">
  <figcaption class="viz__head">
    <span class="kicker">{title}</span>
    {types.length > 1 && (
      <ul class="viz__legend">{types.map((ty) => <li><i style={`background:${COLORS[ty]}`}></i>{LABEL[ty][lang]}</li>)}</ul>
    )}
  </figcaption>
  <div class="tl__body">
    <div class="tl__axis" aria-hidden="true">
      {years.filter((_, i) => i % yearStep === 0).map((y) => <span style={`left:${pct(new Date(y, 0, 1))}%`}>{y}</span>)}
      <i class="tl__now" style={`left:${pct(now)}%`}><em>{lang === 'es' ? 'hoy' : 'today'}</em></i>
    </div>
    <ul class="list-plain tl__rows">
      {items.map((p, i) => {
        const d = p.data;
        const end = d.end ?? now;
        const name = d.acronym ?? localize(d.title, lang);
        const tip = `<b>${esc(name)}</b><br>${formatDate(d.start, lang)} → ${d.end ? formatDate(d.end, lang) : '…'}${d.code ? `<br>${esc(d.code)}` : ''}`;
        return (
          <li class:list={[highlight === p.id && 'is-current']} data-status={projectStatus(p)} data-type={d.type}>
            <a href={l(lang, `/projects/${p.id}/`)} data-tip={tip}>
              <span class="tl__name">{name}</span>
              <span class="tl__lane">
                <span class="tl__bar" style={`left:${pct(d.start)}%;width:${Math.max(0.8, pct(end) - pct(d.start))}%;background:${COLORS[d.type]};color:${COLORS[d.type]};--i:${i}`}></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</figure>
)}

<style>
  .tl__body { position: relative; --name-w: clamp(90px, 28%, 260px); }
  .tl__axis { position: relative; height: 1.4rem; margin-left: var(--name-w); border-bottom: 1px solid var(--border); }
  .tl__axis span { position: absolute; transform: translateX(-50%); font: 10px var(--font-mono); color: var(--muted); }
  .tl__now { position: absolute; top: 0; height: calc(100% + var(--rows-h, 100vh)); border-left: 1px solid var(--accent); box-shadow: 0 0 8px color-mix(in srgb, var(--accent) calc(var(--viz-glow) * 100%), transparent); pointer-events: none; z-index: 1; }
  .tl__now em { position: absolute; top: -1.1rem; left: 4px; font: 600 9px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--accent); font-style: normal; }
  .tl__body { overflow: hidden; }
  .tl__rows li a { display: grid; grid-template-columns: var(--name-w) 1fr; align-items: center; min-height: 30px; text-decoration: none; color: var(--fg); border-bottom: 1px dashed var(--border); }
  .tl__rows li a:hover { background: var(--accent-soft); }
  .tl__rows li.is-current a { background: var(--accent-soft); font-weight: 600; }
  .tl__name { font: .75rem var(--font-mono); padding-right: .75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tl__lane { position: relative; height: 8px; }
  .tl__bar {
    position: absolute; top: 0; height: 100%; border-radius: 1px;
    /* inicio marcado con un remate claro */
    box-shadow: inset 2px 0 0 color-mix(in srgb, currentColor 40%, #fff), 0 0 6px color-mix(in srgb, currentColor calc(var(--viz-glow) * 100%), transparent);
    transform-origin: left; transform: scaleX(0); transition: transform .9s var(--ease) calc(var(--i) * 50ms);
  }
  /* Proyectos en curso: extremo con un pulso "en directo" */
  .tl__rows li[data-status='active'] .tl__bar::after {
    content: ''; position: absolute; right: -3px; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%;
    background: currentColor; box-shadow: 0 0 0 0 currentColor; animation: tl-pulse 2s ease-out infinite;
  }
  @keyframes tl-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 70%, transparent); } 100% { box-shadow: 0 0 0 7px transparent; } }
  :global(.viz.is-in) .tl__bar { transform: none; }
</style>
