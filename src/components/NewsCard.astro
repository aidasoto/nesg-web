---
import { formatDate, l, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';
import { newsSlug, type NewsItem } from '@/lib/data';

interface Props { item: NewsItem; lang: Lang }
const { item, lang } = Astro.props;
const t = useTranslations(lang);
const d = item.data;
const { slug } = newsSlug(item);
---

<a class="card ncard" href={l(lang, `/news/${slug}/`)} data-kind={d.kind} data-text={`${d.title} ${d.summary}`.toLowerCase()}>
  <div class="ncard__top"><span class="kicker kicker--accent">{t(`news.${d.kind}`)}</span><time class="kicker" datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time></div>
  <h3 class="card__title ncard__title">{d.title}</h3>
  <span class="card__bar ncard__bar" aria-hidden="true"></span>
  <p class="ncard__sum">{d.summary}</p>
</a>

<style>
  .ncard__top { display: flex; justify-content: space-between; gap: .5rem; }
  .ncard { padding: 1.6rem; }
  .ncard__title { margin-top: 1.2rem; font-size: 1.3rem; }
  .ncard__bar { margin-top: 1.1rem; }
  .ncard__sum { margin: 1rem 0 0; font: .92rem/1.5 var(--font-body); color: var(--fg); }
</style>
